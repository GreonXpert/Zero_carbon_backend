        },

        {
          "name": "C3 — Invalid: amount=0",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"{{consultantUserId}}\",\n  \"amount\": 0,\n  \"reason\": \"Test zero\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('400 INVALID_AMOUNT', () => pm.response.to.have.status(400));",
              "pm.test('code INVALID_AMOUNT', () => pm.expect(pm.response.json().code).to.equal('INVALID_AMOUNT'));"
            ] } }]
        },

        {
          "name": "C4 — Invalid: missing reason",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"{{consultantUserId}}\",\n  \"amount\": 100\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('400 MISSING_REASON', () => pm.response.to.have.status(400));",
              "pm.test('code MISSING_REASON', () => pm.expect(pm.response.json().code).to.equal('MISSING_REASON'));"
            ] } }]
        },

        {
          "name": "C5 — Invalid: non-admin tries to adjust (FORBIDDEN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"{{clientAdminUserId}}\",\n  \"amount\": 500,\n  \"reason\": \"Unauthorized test\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('403 FORBIDDEN', () => pm.response.to.have.status(403));",
              "pm.test('code FORBIDDEN', () => pm.expect(pm.response.json().code).to.equal('FORBIDDEN'));"
            ] } }]
        },

        {
          "name": "C6 — Drain Consultant to Zero (for quota exhausted test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"{{consultantUserId}}\",\n  \"amount\": -99999,\n  \"reason\": \"Drain for test\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('400 INSUFFICIENT_BALANCE', () => pm.response.to.have.status(400));",
              "pm.test('code INSUFFICIENT_BALANCE', () => pm.expect(pm.response.json().code).to.equal('INSUFFICIENT_BALANCE'));"
            ] } }]
        }

      ]
    },

    {
      "name": "D — Query Execution & Credit Deduction",
      "item": [

        {
          "name": "D1 — Run Query as consultant (deducts credits)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/query", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","query"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is our total Scope 1 emissions for 2025?\",\n  \"clientId\": \"{{targetClientId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('creditsUsed present', () => pm.expect(r.creditsUsed).to.be.a('number'));",
              "pm.test('creditsUsed >= 1', () => pm.expect(r.creditsUsed).to.be.at.least(1));",
              "pm.test('creditsRemaining present', () => pm.expect(r.creditsRemaining).to.be.a('number'));",
              "console.log('Credits used:', r.creditsUsed, '| Remaining:', r.creditsRemaining);"
            ] } }]
        },

        {
          "name": "D2 — Run Query as consultant_admin (unlimited, 0 deduction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/query", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","query"] },
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"Summarise client emissions.\",\n  \"clientId\": \"{{targetClientId}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('creditsUsed is 0 for unlimited', () => pm.expect(r.creditsUsed).to.equal(0));"
            ] } }]
        },

        {
          "name": "D3 — Verify Balance Reduced After Query",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{consultantToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('lifetimeUsed > 0 after query', () => pm.expect(r.lifetime?.used ?? 0).to.be.above(0));",
              "console.log('Current balance:', r.balance);"
            ] } }]
        },

        {
          "name": "D4 — Query as auditor (BLOCKED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auditorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/query", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","query"] },
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"Test\",\n  \"clientId\": \"{{targetClientId}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('403 GREON_IQ_ROLE_BLOCKED', () => pm.response.to.have.status(403));",
              "pm.test('code GREON_IQ_ROLE_BLOCKED', () => pm.expect(pm.response.json().code).to.equal('GREON_IQ_ROLE_BLOCKED'));"
            ] } }]
        }

      ]
    },

    {
      "name": "E — Quota Exhausted Flow",
      "item": [

        {
          "name": "E1 — Check balance before drain",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{consultantToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.collectionVariables.set('preDrainBalance', r.balance);",
              "console.log('Balance before drain:', r.balance);"
            ] } }]
        },

        {
          "name": "E2 — Drain Balance to Zero",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{consultantUserId}}\",\n  \"amount\": -{{preDrainBalance}},\n  \"reason\": \"Drain for quota exhausted test\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('newBalance is 0', () => pm.expect(r.newBalance).to.equal(0));"
            ] } }]
        },

        {
          "name": "E3 — Query with Zero Balance (QUOTA_EXHAUSTED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/query", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","query"] },
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"Test with no credits\",\n  \"clientId\": \"{{targetClientId}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('429 or 402 QUOTA_EXHAUSTED', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([402, 429]);",
              "});",
              "pm.test('code QUOTA_EXHAUSTED', () => pm.expect(pm.response.json().code).to.equal('QUOTA_EXHAUSTED'));"
            ] } }]
        },

        {
          "name": "E4 — Top Up and Retry Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consultantAdminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/greon-iq/quota/adjust", "host": ["{{baseUrl}}"], "path": ["api","greon-iq","quota","adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"{{consultantUserId}}\",\n  \"amount\": 500,\n  \"reason\": \"Emergency top-up\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('newBalance 500', () => pm.expect(pm.response.json().newBalance).to.equal(500));"
            ] } }]
        }

      ]
    },

